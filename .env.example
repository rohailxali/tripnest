# ─────────────────────────────────────────────────────────────────────────────
# Plan a route — Environment Variables
# Copy this file to .env and fill in your values before running.
# ─────────────────────────────────────────────────────────────────────────────

# API Base URL — points to the local backend server (do not change for local dev)
REACT_APP_API_URL=http://localhost:5000

# Maps Integration (optional)
# Google Maps JavaScript API key (for the interactive map tab)
REACT_APP_MAPS_KEY=

# App metadata
REACT_APP_NAME=Plan a route
REACT_APP_VERSION=1.0.0
