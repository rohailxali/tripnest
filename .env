# ─────────────────────────────────────────────────────────────────────────────
# TripNest Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# API Base URL
# Leave empty to use mock data (default for local dev).
# Point to your Docker backend to use real data.
REACT_APP_API_URL=http://localhost:5000

# Maps Integration
# Google Maps JavaScript API key (for the interactive map)
REACT_APP_MAPS_KEY=

# App metadata
REACT_APP_NAME=TripNest
REACT_APP_VERSION=1.0.0
